# 이 파일은 커밋합니다. 실제 값은 .env 에 넣으세요 (.env 는 gitignore 처리됨)
# 사용법: cp .env.example .env  후 값 채우기

# ── LLM (배치 파싱 + 요약 생성) ───────────────
ANTHROPIC_API_KEY=

# ── 데이터 수집 ───────────────────────────────
# 복지로 오픈API 인증키 (8/7 신청, 승인 대기)
BOKJIRO_API_KEY=
# 공공데이터포털 인증키 (화성시 데이터셋 확인 후)
DATA_GO_KR_API_KEY=

# ── DB (Supabase / PostgreSQL) ────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 프론트 → 백엔드 ───────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
