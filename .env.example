# 이 파일은 커밋합니다. 실제 값은 .env 에 넣으세요 (.env 는 gitignore 처리됨)
# 사용법: cp .env.example .env  후 값 채우기

# ── LLM (배치 파싱 + 요약 생성) ───────────────
# 배치 스크립트에서만 쓴다. 서버(apps/api)는 이 키 없이 동작한다 —
# 판정 요약은 미리 만들어 data/summaries.json 에 커밋해 두고 읽기만 하기 때문.
#   대상·예상 비용: python apps/api/tools/generate_summaries.py --dry-run
#   실제 생성:      python apps/api/tools/generate_summaries.py
ANTHROPIC_API_KEY=
# Cerebras 무료 티어로 파싱 시 사용 — Groq 한도 소진 시 대체 (cloud.cerebras.ai에서 발급, csk_로 시작)
CEREBRAS_API_KEY=
# Gemini 무료 티어로 파싱 시 사용 (aistudio.google.com에서 발급)
GEMINI_API_KEY=
# Groq 무료 티어로 파싱 시 사용 — 현재 기본값 (console.groq.com에서 발급, gsk_로 시작)
GROQ_API_KEY=

# ── 데이터 수집 ───────────────────────────────
# 복지로 오픈API (8/8 승인·검증 완료 — 중앙부처 복지서비스 461건)
# 엔드포인트는 기본 주소만: https://apis.data.go.kr/B554287/NationalWelfareInformationsV001
# (목록/상세 오퍼레이션은 스크립트가 붙임. 필수 파라미터: callTp=L + srchKeyCode=001)
BOKJIRO_ENDPOINT=
BOKJIRO_API_KEY=
# 참고: Jupyter 파일 브라우저는 숨김 파일(.env)을 표시하지 않음 —
#       브라우저로 편집하려면 루트의 env.local.txt(동일 형식, gitignore 등록) 사용
# 공공데이터포털 인증키 (화성시 데이터셋 확인 후)
DATA_GO_KR_API_KEY=

# ── DB (Supabase / PostgreSQL) ────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 백엔드 (apps/api) ─────────────────────────
# 정책 JSON 디렉터리. 비우면 <레포루트>/data/policies (apps/api/app/store.py 기본값)
# Render 배포에서 /health 의 policies 가 0 이면 절대경로로 지정:
#   /opt/render/project/src/data/policies
POLICIES_DIR=

# CORS 허용 출처 (쉼표 구분). 프론트가 브라우저에서 직접 호출하므로 필수 (#27)
# 비우면 로컬 개발(localhost:3000)만 허용된다.
# *.vercel.app 프리뷰 도메인은 코드에 정규식으로 열려 있어 여기 적지 않아도 된다 —
# Vercel 커스텀 도메인을 붙이면 그 주소를 여기에 추가한다.
#   예: CORS_ORIGINS=https://hwaseong-policy.vercel.app
CORS_ORIGINS=

# ── 프론트 → 백엔드 ───────────────────────────
# 로컬은 localhost:8000, 배포 후에는 Render 서비스 URL (render.yaml 참조)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
