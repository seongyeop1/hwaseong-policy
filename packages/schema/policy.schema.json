{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/hwaseong-policy/packages/schema/policy.schema.json",
  "title": "정책 표준 스키마",
  "description": "화성시/중앙 지원정책 1건의 표준 형식. 이 파일은 팀의 계약서이며, 변경 시 전원 리뷰 필요.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "title",
    "category",
    "lifecycle",
    "beneficiary",
    "benefit",
    "conditions",
    "apply_channel",
    "required_docs",
    "source_url"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^(hs|kr)-[0-9]{4}-[0-9]{4}$",
      "description": "hs=화성시 자체사업, kr=중앙정책. 예: hs-2026-0042"
    },
    "title": { "type": "string", "minLength": 2 },
    "category": {
      "type": "string",
      "enum": ["복지", "주거", "일자리", "교육", "보육", "건강", "문화", "기타"]
    },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["전입", "청년", "결혼·신혼", "출산·육아", "노후"]
      },
      "description": "생애주기 축. 5개 고정. '1인가구'는 여기 오지 않는다(household 축)."
    },
    "beneficiary": {
      "type": "string",
      "enum": ["세대주", "본인", "배우자", "자녀", "가구"],
      "description": "가구 단위 판정용 수급 주체"
    },
    "benefit": {
      "type": "string",
      "minLength": 2,
      "description": "지원 내용 한 줄 요약. 상세 페이지·비교 뷰 공용. 검수 6항목 포함."
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "age": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0, "maximum": 120 },
            "max": { "type": "integer", "minimum": 0, "maximum": 120 }
          }
        },
        "income_percentile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max": { "type": "number", "minimum": 0, "maximum": 300 }
          },
          "description": "기준중위소득 %. 입력받지 않고 verify_required 로 처리."
        },
        "residence_months": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 }
          },
          "description": "거주기간 요건. D-day 계산의 재료."
        },
        "household": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["1인가구", "신혼부부", "유자녀가구", "한부모", "다자녀", "다문화", "제한없음"]
          },
          "description": "가구 유형 축. enum 은 8/7 스키마 세션에서 확정."
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "중복수급 제한. 공고에 명시된 경우만 파싱. 표시 전용 — 판정 로직에 사용 금지."
    },
    "deadline": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "YYYY-MM-DD. 상시 접수는 null."
    },
    "apply_channel": { "type": "string", "minLength": 2 },
    "required_docs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "공고에 미표기 시 [\"공고 확인 필요\"] 로 채우고 담당부서 연락처를 contact 에 기입"
    },
    "verify_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["income_percentile", "household", "residence_months", "age"]
      },
      "description": "자가신고 불가 항목 → '서류 확인 필요' 분류 트리거. API 응답에서는 manual_conditions와 합쳐져 {key,label,hint} 객체 배열(verify)로 정규화된다 — packages/schema/api-contract.md v1.1 참조"
    },
    "manual_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2,
            "description": "공고 원문의 서술형 조건. 예: 무주택자에 한함"
          },
          "hint": {
            "type": "string",
            "description": "확인 방법 안내. 예: 공고 원문 기준 — 무주택 여부 증빙 서류로 확인"
          }
        }
      },
      "description": "기계 판정이 불가능한 서술형 자격요건 (8/7 조건 이원화 결정). 하나라도 있으면 해당 정책의 최고 분류는 '서류 확인 필요'. conditions에 욱여넣지 않는다."
    },
    "contact": {
      "type": "string",
      "description": "담당부서 + 연락처. required_docs 미표기 정책의 Plan B."
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "review": {
      "type": "object",
      "description": "2인 교차 검수 기록. 검수 완료분만 main 에 머지한다.",
      "additionalProperties": false,
      "required": ["parsed_by", "reviewed_by", "reviewed_at", "checklist"],
      "properties": {
        "parsed_by": { "type": "string" },
        "reviewed_by": { "type": "string" },
        "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "checklist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditions", "deadline", "benefit", "required_docs", "apply_channel", "source_url", "conditions_complete"],
          "properties": {
            "conditions": { "type": "boolean", "description": "조건 수치(나이·소득·거주개월) 원문 대조" },
            "deadline": { "type": "boolean" },
            "benefit": { "type": "boolean" },
            "required_docs": { "type": "boolean" },
            "apply_channel": { "type": "boolean" },
            "source_url": { "type": "boolean" },
            "conditions_complete": { "type": "boolean", "description": "⑦ 원문 자격요건 전수 대조 — 공고의 모든 조건이 conditions 또는 manual_conditions 중 한 곳에 존재하는가. 서술형 조건이 통째로 빠지면 조용한 과대 판정이 된다 (조건 이원화의 필수 짝)" },
            "exclusions": { "type": "boolean", "description": "파싱된 경우에만 대조" }
          }
        }
      }
    }
  }
}
